# ====================== TELEGRAM (Bot 2 - Judge) ======================
TG_TOKEN=your_judge_bot_token
TG_CHAT_ID=your_chat_id
TG_ADMIN_IDS=123456789

# ====================== MEXC ======================
MEXC_API_KEY=mx0...
MEXC_SECRET=your_secret_here

# ====================== DATABASE (Shared Railway PostgreSQL) ======================
DATABASE_URL=postgresql://user:pass@host:port/railway

# ====================== CAPITAL & RISK ======================
CAPITAL=300
MAX_POSITION_USDT=90
STOP_LOSS_PCT=2.2
TAKE_PROFIT_PCT=4.5
MAX_OPEN_POSITIONS=3
MODE=paper

# ====================== JUDGE ======================
MIN_CONVICTION_SCORE=65
LOG_LEVEL=INFO
PAUSE_ON_START=false
