# انسخ الملف ده باسم .env لو هتشغل محلي - وممنوع تعمل commit لملف .env الحقيقي.
# في Railway: كل متغير من دول بتضيفه في تبويب Variables كـ Secret.

# ---- Bitget API (سرية جداً) ----
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# ---- وضع التشغيل ----
DRY_RUN=false

# ---- الأزواج - مفصولة بفاصلة ----
SYMBOLS=BTC/USDT:USDT,ETH/USDT:USDT

# ---- نوع السوق: swap أو spot ----
MARKET_TYPE=swap

# ---- الفريم الزمني ----
TIMEFRAME=1m

# ---- الاستراتيجية ----
EMA_FAST=9
EMA_SLOW=21
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
ATR_PERIOD=14
ATR_SL_MULT=1.2
ATR_TP_MULT=1.8

# ---- إدارة المخاطر ----
RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS_PCT=3.0
MAX_OPEN_POSITIONS=2
LEVERAGE=3

# ---- تكرار الفحص بالثواني ----
POLL_INTERVAL_SECONDS=15

# ---- قاعدة البيانات - Railway بيحطها تلقائي عند إضافة Postgres plugin ----
DATABASE_URL=

# ---- بوت تليجرام للتحكم الكامل ----
# احصل عليه من @BotFather على تليجرام
TELEGRAM_BOT_TOKEN=
# آيديك على تليجرام (احصل عليه من @userinfobot) - افصل بفاصلة لو أكتر من شخص مصرح له
TELEGRAM_CHAT_ID=
